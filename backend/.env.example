# Application
APP_NAME="Document Intelligence & Question Extraction Service"
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1

# Database
# PostgreSQL with psycopg3 driver
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/doc_intelligence
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/doc_intelligence_test

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security
JWT_SECRET_KEY=change_this_to_a_very_secure_secret_key_in_production_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage
MAX_FILE_SIZE_MB=25
STORAGE_PATH=./storage

# OCR
OCR_PROVIDER=tesseract

# LLM Configuration
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Cloud LLM Fallback (Optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct

# Vision Provider (Optional)
VISION_PROVIDER=
